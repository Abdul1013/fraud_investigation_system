# ============================================================================
# FILE:        .env.example
# PURPOSE:     Document local model, database, and explicit authentication settings.
# OWNER:       Platform & Operations
# SINCE:       week-26
# RELATED:     ADR-003, Week 27 retrieval, Week 28 identity boundary
# NOTES:
#   - No real secrets or default API accounts belong in this example.
#   - Export variables explicitly; Maven does not automatically load this file.
# ============================================================================
# WEEK 27: database and model configuration for local learning.
# Ingestion and retrieval use separate embedding indexes; local,ollama selects semantic retrieval.
# These are process environment variables. Maven does not automatically load this file.
POSTGRES_URL=jdbc:postgresql://localhost:5432/fraud
POSTGRES_USER=fraud
POSTGRES_PASSWORD=fraud
EMBEDDING_PROVIDER=local
INGESTION_REPORTS_DIRECTORY=reports
# For reviewed public-only OpenAI ingestion: also set SPRING_AI_MODEL_EMBEDDING=openai
# and EMBEDDING_PROVIDER=openai. C2 external embedding is blocked.
OPENAI_API_KEY=

# Week 27 local semantic retrieval (or start with the local,ollama profiles):
# RETRIEVAL_EMBEDDING_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma
RETRIEVAL_ANSWER_PROVIDER=extractive
OLLAMA_ANSWER_MODEL=gemma3:4b

# Week 28: uncomment only after replacing the hash with your own BCrypt hash.
# All three values are required for each account. Never commit real hashes.
# ENGINE_SECURITY_ACCOUNTS_0_USERNAME=local-curator
# ENGINE_SECURITY_ACCOUNTS_0_PASSWORDHASH='{bcrypt}<your BCrypt hash>'
# ENGINE_SECURITY_ACCOUNTS_0_ROLE=KNOWLEDGE_CURATOR
# Other roles: INVESTIGATOR, ANALYST, AUDITOR. Provision case grants separately.

# Native local Week 28 investigator (separate from embeddings and quote selection):
INVESTIGATION_MODEL_PROVIDER=disabled
INVESTIGATION_MODEL=qwen2.5:1.5b
# Approval signing is disabled without a separately generated Base64 key (at least 32 random bytes).
# A signing key does not bypass the runtime deny-all step-up verifier.
APPROVAL_SIGNING_KEY=
# Local stdio MCP additionally needs explicit process identity and a persisted case grant:
# INVESTIGATION_MCP_SUBJECT=local-investigator
# INVESTIGATION_MCP_CASEID=synthetic-case-1
