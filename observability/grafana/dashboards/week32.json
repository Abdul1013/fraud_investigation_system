{
  "description": "FILE: observability/grafana/dashboards/week32.json; PURPOSE: display bounded operation, usage and estimated cost metrics; OWNER: Platform; SINCE: week-32; NOTES: short-window demonstration only, not SLO evidence",
  "title": "Fraud lifecycle operations",
  "uid": "fraud-week32",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Provider errors per second",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(fraud_operation_total{stage=\"provider\",outcome=\"error\"}[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Pending outbox deliveries",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (queue) (fraud_outbox_pending)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Operation p95 seconds",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le,stage) (rate(fraud_operation_duration_milliseconds_bucket[1m]))) / 1000",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Actual provider token counts",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (direction) (fraud_model_tokens_total)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Estimated local compute USD (assumption, not invoice)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prometheus"
      },
      "targets": [
        {
          "expr": "sum(fraud_local_compute_estimated_usd_total)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "API charges only (local provider)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prometheus"
      },
      "targets": [
        {
          "expr": "sum(fraud_provider_api_charged_usd_total)",
          "refId": "A"
        }
      ]
    }
  ]
}
