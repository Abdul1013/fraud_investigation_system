# ============================================================================
# FILE: infra/temporal/Dockerfile.server
# PURPOSE: Pin Temporal server tooling and keep secrets outside image layers.
# OWNER: Platform & Operations
# SINCE: week-34
# RELATED: infra/terraform/ecs.tf
# NOTES: Contains no credentials. Images run privately and require reviewed deployment inputs.
# ============================================================================
FROM temporalio/server:1.32.1@sha256:acecbab5b0b8ae9cf4012b508866ca97feda3709577bf157b537239f40029049
COPY --chmod=0444 infra/temporal/server.yml /etc/temporal/staging.yml
COPY --chmod=0555 infra/temporal/server-entrypoint.sh /etc/temporal/staging-entrypoint.sh
ADD --checksum=sha256:90a6f1a7978a1b1b096dca6c57511ca48d3b8cf052f8e704baf358f34ea2f21b --chmod=0444 https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem /etc/temporal/aws-rds.pem
ENV USER=temporal HOME=/tmp
USER 10001:10001
ENTRYPOINT ["/etc/temporal/staging-entrypoint.sh"]
